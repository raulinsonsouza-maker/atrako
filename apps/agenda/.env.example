# Database (SQLite local — use PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Resend
RESEND_API_KEY=""
EMAIL_FROM="Book Symbius <agendamento@book.symbius.com.br>"

# Cron (POST /api/cron/booking-comms com header Authorization: Bearer …)
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google (login NextAuth + Google Calendar OAuth)
# Redirect login: {NEXTAUTH_URL}/api/auth/callback/google
# Redirect Calendar: {NEXT_PUBLIC_APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Mercado Pago OAuth (app Symbius — também configurável em /admin/config)
# Redirect salões: {NEXTAUTH_URL}/api/mercadopago/callback
# Redirect plataforma: {NEXTAUTH_URL}/api/admin/mercadopago/callback
# Webhook salões: {NEXT_PUBLIC_APP_URL}/api/webhooks/mercadopago
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
MERCADOPAGO_REDIRECT_URI="http://localhost:3000/api/mercadopago/callback"
PLATFORM_MERCADOPAGO_REDIRECT_URI="http://localhost:3000/api/admin/mercadopago/callback"

# Mercado Pago plataforma (assinatura SaaS — preferir /admin/config; env = fallback)
# Webhook: {NEXT_PUBLIC_APP_URL}/api/webhooks/mercadopago-platform
PLATFORM_MERCADOPAGO_ACCESS_TOKEN=""
PLATFORM_MERCADOPAGO_PUBLIC_KEY=""
# true = onboarding exige Pix/cartão (ou ligue “Cobrança ativa” em /admin/config)
PLATFORM_BILLING_ENABLED="true"

# WhatsApp Cloud API (canal único da plataforma — também configurável em /admin/whatsapp)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Template Meta (opcional) para convite de profissional — body: nome, empresa, e-mail, senha
WHATSAPP_TEMPLATE_PRO_INVITE=""
# Chave para criptografar token no banco (obrigatória em produção)
PLATFORM_SECRETS_KEY=""
