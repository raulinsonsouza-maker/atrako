# Database (PostgreSQL local via Docker)
# User: postgres, Password: admin - configure via DATABASE_URL only, never hardcode.
DATABASE_URL="postgresql://postgres:admin@localhost:5432/inout_central?schema=public"

# Google Sheets API (Service Account)
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets.readonly

# Meta Marketing API / Facebook Login for Business
# App credentials (nunca no frontend). Conexão por workspace em /config/conexoes.
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=          # obrigatório para Login for Business (App Dashboard)
# META_GRAPH_API_VERSION=v26.0
# META_OAUTH_REDIRECT_URI=http://localhost:5000/api/atrako/oauth/meta/callback
# Legado (fallback global — não usar para clientes novos):
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_XXXXXXXX
# ATRAKO_CONNECTIONS_SECRET=     # AES para WorkspaceConnection.credentialsEnc

# Google Ads API (OAuth - substitui/complementa dados de planilhas)
# O DEVELOPER_TOKEN é obtido em https://ads.google.com/aw/apicenter (conta gerente Google Ads)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# customer_id por cliente em Conta (plataforma GOOGLE_ADS)

# Google Analytics 4 (Service Account - JSON completo como string)
# GOOGLE_ANALYTICS_CREDENTIALS={"type":"service_account",...}
# property_id por cliente em Conta (plataforma GOOGLE_ANALYTICS)

# Sync endpoint protection (cron job calls with this token)
# SYNC_CRON_TOKEN=

# Internal username/password authentication (one-time bootstrap only)
# INTERNAL_AUTH_BOOTSTRAP=false
# INTERNAL_BOOTSTRAP_USERNAME=
# INTERNAL_BOOTSTRAP_PASSWORD=
# INTERNAL_BOOTSTRAP_LEGACY_USER_ID= # required when preserving an existing admin row
# SESSION_SECRET= # required in production; used to HMAC login-throttle bucket identifiers

# Atrako event bridge (shell)
# ATRAKO_EVENTS_TOKEN=dev-token
# ATRAKO_EVENTS_URL=http://localhost:5000/api/atrako/events
# ATRAKO_OUTBOX_URL=
# ATRAKO_CONNECTIONS_TOKEN=dev-local-token
# Hub OAuth (Mercado Pago / Mercado Livre / Instagram)
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# MP_REDIRECT_URI=http://localhost:5000/api/atrako/oauth/mercadopago/callback
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=
# ML_REDIRECT_URI=http://localhost:5000/api/atrako/oauth/mercadolivre/callback
# SYMBIUS_IG_APP_ID=
# SYMBIUS_IG_APP_SECRET=

# Sistemas prontos do monorepo (módulos em absorção)
# ATRAKO_CRM_URL=http://localhost:3001
# ATRAKO_AGENDA_URL=http://localhost:3002
# ATRAKO_COMMERCE_URL=http://localhost:3003
# ATRAKO_SOCIAL_URL=http://localhost:3004
# ATRAKO_FORMS_URL=
