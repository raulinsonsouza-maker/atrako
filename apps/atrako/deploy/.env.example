# Copiar para /opt/apps/atrako/.env na VPS (não commitar valores reais)

POSTGRES_USER=atrako
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=atrako

# Mesmo Postgres; schema public = Atrako; schema symbius = Social
DATABASE_URL=postgresql://atrako:CHANGE_ME_STRONG_PASSWORD@db:5432/atrako?schema=public
SOCIAL_DATABASE_URL=postgresql://atrako:CHANGE_ME_STRONG_PASSWORD@db:5432/atrako?schema=symbius

ATRAKO_CONNECTIONS_SECRET=CHANGE_ME_32_PLUS_CHARS_SECRET_KEY!!
ATRAKO_CONNECTIONS_TOKEN=CHANGE_ME_SERVICE_TOKEN
ATRAKO_EVENTS_TOKEN=CHANGE_ME_EVENTS_TOKEN
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET

NEXTAUTH_URL=https://atrako.com.br
APP_URL=https://atrako.com.br
NEXT_PUBLIC_APP_URL=https://atrako.com.br

# Opcional — preencher depois
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://atrako.com.br/api/atrako/oauth/mercadopago/callback
MP_WEBHOOK_SECRET=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
