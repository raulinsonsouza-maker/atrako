generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BUYER
}

enum ProductType {
  FILE
  COURSE
  BUNDLE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum OfferType {
  ORDER_BUMP
  POST_PURCHASE
}

enum CouponType {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  passwordHash  String?
  role          Role      @default(BUYER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  entitlements   Entitlement[]
  lessonProgress LessonProgress[]
  auditLogs      AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?
  type            ProductType   @default(FILE)
  status          ProductStatus @default(DRAFT)
  priceCents      Int
  coverUrl        String?
  salesPage       Json?
  maxInstallments Int?
  metaPixelId     String?
  metaCapiToken   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  files            ProductFile[]
  modules          Module[]
  orderItems       OrderItem[]
  entitlements     Entitlement[]
  offersAsTrigger  Offer[]       @relation("TriggerProduct")
  offersAsOffered  Offer[]       @relation("OfferedProduct")
  couponProducts   CouponProduct[]
}

model ProductFile {
  id        String   @id @default(cuid())
  productId String
  name      String
  key       String
  sizeBytes Int      @default(0)
  mimeType  String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Module {
  id        String   @id @default(cuid())
  productId String
  title     String
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id           String   @id @default(cuid())
  moduleId     String
  title        String
  position     Int      @default(0)
  bunnyVideoId String?
  content      String?
  durationSec  Int?
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Offer {
  id               String    @id @default(cuid())
  triggerProductId String
  offeredProductId String
  type             OfferType
  discountPercent  Int       @default(0)
  headline         String?
  description      String?
  position         Int       @default(0)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  triggerProduct   Product   @relation("TriggerProduct", fields: [triggerProductId], references: [id], onDelete: Cascade)
  offeredProduct   Product   @relation("OfferedProduct", fields: [offeredProductId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Int
  maxUses         Int?
  usedCount       Int        @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  products        CouponProduct[]
  orders          Order[]
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model MercadoPagoAccount {
  id               String    @id @default(cuid())
  mpUserId         String?
  accessTokenEnc   String
  refreshTokenEnc  String?
  publicKey        String
  liveMode         Boolean   @default(true)
  expiresAt        DateTime?
  connectedAt      DateTime  @default(now())
  status           String    @default("CONNECTED")
  updatedAt        DateTime  @updatedAt
}

model PaymentSettings {
  id                  String  @id @default("default")
  cardEnabled         Boolean @default(true)
  pixEnabled          Boolean @default(true)
  maxInstallments     Int     @default(12)
  minInstallments     Int     @default(1)
  statementDescriptor String  @default("LOJA")
  webhookSecret       String?
  updatedAt           DateTime @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  userId            String?
  email             String
  name              String?
  cpf               String?
  phone             String?
  status            OrderStatus @default(PENDING)
  subtotalCents     Int
  discountCents     Int         @default(0)
  totalCents        Int
  couponId          String?
  mpOrderId         String?
  mpPaymentId       String?
  pixQrCode         String?
  pixQrCodeBase64   String?
  pixCopyPaste      String?
  eventId           String?
  fbp               String?
  fbc               String?
  fbclid            String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  parentOrderId     String?
  termsAcceptedAt      DateTime?
  abandonedEmailSentAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  approvedAt           DateTime?

  user     User?       @relation(fields: [userId], references: [id])
  coupon   Coupon?     @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  parent   Order?      @relation("OrderUpsell", fields: [parentOrderId], references: [id])
  children Order[]     @relation("OrderUpsell")
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String
  name         String
  priceCents   Int
  quantity     Int    @default(1)
  installments Int?
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])
}

model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  productId String
  orderId   String?
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model PixelConfig {
  id        String   @id @default("default")
  pixelId   String?
  capiToken String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
