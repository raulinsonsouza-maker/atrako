[Unit]
Description=CRM Next.js App
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/crm
EnvironmentFile=/var/www/crm/.env
ExecStart=/usr/bin/node node_modules/.bin/next start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
