{
  "name": "@atrako/crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev --turbo",
    "dev:3001": "node ./node_modules/next/dist/bin/next dev --turbo -p 3001",
    "build": "next build",
    "build:vps": "NODE_OPTIONS='--max-old-space-size=2048' next build",
    "start": "next start",
    "start:3001": "next start -p 3001",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "worker": "node jobs/worker.js",
    "wweb": "npm run --prefix services/whatsapp-wweb start",
    "create-admin": "node scripts/create-admin.mjs",
    "check-db": "node scripts/check-db.mjs"
  },
  "dependencies": {
    "@atrako/events": "file:../../packages/events",
    "@prisma/client": "^6.0.0",
    "better-auth": "^1.4.0",
    "bullmq": "^5.0.0",
    "clsx": "^2.1.0",
    "googleapis": "^170.1.0",
    "ioredis": "^5.4.0",
    "lucide-react": "^0.460.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^3.7.0",
    "stripe": "^17.0.0",
    "whatsapp-web.js": "^1.26.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  }
}
